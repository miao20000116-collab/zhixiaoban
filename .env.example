# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_career_assistant
VECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_career_assistant

# Text LLM — DeepSeek
OPENAI_API_KEY=your-deepseek-api-key
OPENAI_API_BASE=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash
EMBEDDING_MODEL=text-embedding-3-small

# Speech ASR/TTS — SiliconFlow (separate from text)
SPEECH_API_KEY=your-siliconflow-api-key
SPEECH_API_BASE=https://api.siliconflow.cn/v1
# ASR: cheap Chinese SenseVoice
WHISPER_MODEL=FunAudioLLM/SenseVoiceSmall
# TTS: CosyVoice2 Chinese voices
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
MEMORY_IMPORTANCE_THRESHOLD=6
AUDIO_STORAGE_DIR=data/audio
MEDIA_BASE_URL=http://localhost:8000/media

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
