      ],
      "failure_criteria": [
        "把「上过课程」写成「有落地经验」",
        "无视约束"
      ],
      "required_constraint_keywords_any": ["RAG", "约束", "没有", "课程", "不会虚构", "不虚构"],
      "scoring_dimensions": ["准确性", "真实性", "可执行性"],
      "pass_threshold": 70,
      "warn_threshold": 55
    },
    {
      "case_id": "gap_01_with_jd_and_memory",
      "module": "Career Gap Analysis",
      "agent": "career_gap",
      "mode": "live",
      "setup": ["seed_memory_via_chat"],
      "user_input": {
        "target_position": "AI产品经理",
        "company": "示例科技",
        "target_jd": "{{ai_pm_jd}}"
      },
      "expected_output_features": [
