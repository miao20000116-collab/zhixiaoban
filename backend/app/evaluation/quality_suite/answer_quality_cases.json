        "未指出虚构转化率/主导职责"
      ],
      "expect_risk_in": ["high", "medium"],
      "expect_fabricated": true,
      "scoring_dimensions": ["真实性", "准确性", "AI产品经理场景契合度"],
      "pass_threshold": 70,
      "warn_threshold": 55
    },
