# 复制为 deploy/.env 后填写（不要提交到 Git）

# ── Oracle 后端 API 域名（A 记录指向 VM 公网 IP，语音面试需要 HTTPS）
DOMAIN=api.你的域名.com

# ── Netlify 前端地址（CORS 白名单，与 Netlify 站点 URL 完全一致，无末尾斜杠）
NETLIFY_ORIGIN=https://你的项目.netlify.app

# 数据库（自行生成强密码）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=ai_career_assistant

# 文本 LLM（DeepSeek）
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_API_BASE=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash
LLM_THINKING_ENABLED=false

# 语音 ASR/TTS（硅基流动，与 DeepSeek Key 不同）
SPEECH_API_KEY=sk-your-siliconflow-key
SPEECH_API_BASE=https://api.siliconflow.cn/v1
WHISPER_MODEL=FunAudioLLM/SenseVoiceSmall
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna

# Netlify 环境变量在 Netlify 控制台单独配置，见 deploy/netlify.env.example
